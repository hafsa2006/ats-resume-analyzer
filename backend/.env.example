# Server
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# MongoDB — choose ONE option:

# Option A: Local MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/ats_analyzer
# USE_LOCAL_MONGO=true

# Option B: MongoDB Atlas (SRV)
# MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority

# Option C: Atlas standard URI (use if SRV DNS fails on Windows)
# MONGO_URI_STANDARD=mongodb://<DB_USER>:<DB_PASSWORD>@<HOST1>:27017,<HOST2>:27017/<DB_NAME>?ssl=true&replicaSet=<REPLICA_SET>&authSource=admin

# Auth — generate a strong secret for production (e.g. openssl rand -hex 32)
JWT_SECRET=<GENERATE_A_STRONG_RANDOM_SECRET>

# Optional: Google Gemini AI enhancements
GEMINI_API_KEY=

# Optional: dev / ops
# ALLOW_START_WITHOUT_DB=true
# MOCK_DASHBOARD=false
